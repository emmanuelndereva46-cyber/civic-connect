
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "generated/prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
