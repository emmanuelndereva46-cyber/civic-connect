# Copy to .env for local development. Never commit actual secrets.
DATABASE_URL=mysql://USERNAME:PASSWORD@YOUR_TIDB_HOST:4000/civicconnect
TIDB_CA_CERT_PATH=certs/isrgrootx1.pem
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
PORT=5000

# One-time first-administrator bootstrap. Remove from Vercel after use.
ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-one-time-token
