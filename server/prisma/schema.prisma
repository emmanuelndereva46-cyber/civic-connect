// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CITIZEN
  GOVERNMENT_OFFICER
  SYSTEM_ADMINISTRATOR
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_INFORMATION
  RESOLVED
  CLOSED
  REJECTED
}

enum PigeonholeType {
  SUGGESTION
  COMPLAINT
  FEEDBACK
  CONCERN
  COMPLIMENT
  OTHER
}

enum PigeonholeStatus {
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESPONSE_PROVIDED
  CLOSED
}

model User {
  id             Int           @id @default(autoincrement())
  fullName       String        @map("full_name") @db.VarChar(150)
  email          String        @unique @db.VarChar(191)
  phone          String?       @unique @db.VarChar(30)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  role           UserRole      @default(CITIZEN)
  accountStatus  AccountStatus @default(ACTIVE) @map("account_status")
  departmentId   Int?          @map("department_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  submittedReports      Report[]               @relation("ReportSubmitter")
  assignedReports       Report[]               @relation("ReportAssignee")
  reportUpdates         ReportUpdate[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  pigeonholeSubmissions PigeonholeSubmission[] @relation("PigeonholeSubmitter")
  pigeonholeUpdates     PigeonholeUpdate[]

  @@index([role])
  @@index([departmentId])
  @@index([accountStatus])
  @@map("users")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.Text
  email       String?  @db.VarChar(191)
  phone       String?  @db.VarChar(30)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users      User[]
  categories Category[]
  reports    Report[]

  @@index([isActive])
  @@map("departments")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  description  String?  @db.Text
  departmentId Int?     @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reports    Report[]

  @@index([departmentId])
  @@index([isActive])
  @@map("categories")
}

model Report {
  id                Int          @id @default(autoincrement())
  referenceNumber   String       @unique @map("reference_number") @db.VarChar(30)
  title             String       @db.VarChar(200)
  description       String       @db.Text
  location          String       @db.VarChar(255)
  latitude          Decimal?     @db.Decimal(10, 7)
  longitude         Decimal?     @db.Decimal(10, 7)
  status            ReportStatus @default(SUBMITTED)
  citizenId         Int          @map("citizen_id")
  departmentId      Int?         @map("department_id")
  categoryId        Int          @map("category_id")
  assignedOfficerId Int?         @map("assigned_officer_id")
  rejectionReason   String?      @map("rejection_reason") @db.Text
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  resolvedAt        DateTime?    @map("resolved_at")

  citizen         User               @relation("ReportSubmitter", fields: [citizenId], references: [id], onDelete: Restrict)
  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedOfficer User?              @relation("ReportAssignee", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  attachments     ReportAttachment[]
  updates         ReportUpdate[]
  notifications   Notification[]

  @@index([citizenId, createdAt])
  @@index([status, createdAt])
  @@index([departmentId, status])
  @@index([categoryId])
  @@index([assignedOfficerId])
  @@map("reports")
}

model ReportAttachment {
  id         Int      @id @default(autoincrement())
  reportId   Int      @map("report_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.VarChar(500)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  fileSize   Int      @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_attachments")
}

model ReportUpdate {
  id        Int          @id @default(autoincrement())
  reportId  Int          @map("report_id")
  userId    Int?         @map("user_id")
  status    ReportStatus?
  comment   String       @db.Text
  isPublic  Boolean      @default(true) @map("is_public")
  createdAt DateTime     @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([userId])
  @@map("report_updates")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  reportId  Int?      @map("report_id")
  title     String    @db.VarChar(200)
  message   String    @db.Text
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([reportId])
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model PigeonholeCategory {
  id          Int            @id @default(autoincrement())
  name        PigeonholeType @unique
  description String?        @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")

  submissions PigeonholeSubmission[]

  @@index([isActive])
  @@map("pigeonhole_categories")
}

model PigeonholeSubmission {
  id              Int              @id @default(autoincrement())
  referenceNumber String           @unique @map("reference_number") @db.VarChar(30)
  type            PigeonholeType
  subject         String           @db.VarChar(200)
  message         String           @db.Text
  isAnonymous     Boolean          @default(false) @map("is_anonymous")
  submitterId     Int?             @map("submitter_id")
  categoryId      Int              @map("category_id")
  status          PigeonholeStatus @default(SUBMITTED)
  response        String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  closedAt        DateTime?        @map("closed_at")

  submitter   User?                  @relation("PigeonholeSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  category    PigeonholeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments PigeonholeAttachment[]
  updates     PigeonholeUpdate[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([submitterId, createdAt])
  @@map("pigeonhole_submissions")
}

model PigeonholeAttachment {
  id           Int      @id @default(autoincrement())
  submissionId Int      @map("submission_id")
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  fileSize     Int      @map("file_size")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  submission PigeonholeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("pigeonhole_attachments")
}

model PigeonholeUpdate {
  id           Int              @id @default(autoincrement())
  submissionId Int              @map("submission_id")
  userId       Int?             @map("user_id")
  status       PigeonholeStatus?
  message      String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")

  submission PigeonholeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@index([userId])
  @@map("pigeonhole_updates")
}
